type Employee {
    id: String!
    name: String!
    dateOfBirth: String!
    city: String!
    salary: Float!
    gender: String
    email: String
}

input CreateEmployeeInput {
    name: String!
    dateOfBirth: String!
    city: String!
    salary: Float!
    gender: String
    email: String
}

type Query {
    employees: [Employee]
    employeeById(id: String!): Employee
}

type Mutation {
    newEmployee(createEmployeeInput: CreateEmployeeInput!): Employee
    deleteEmployee(id: String!): Boolean
}
